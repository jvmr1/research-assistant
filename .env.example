# Copie para .env e preencha localmente. Nunca publique .env.

# OpenRouter é opcional, mas recomendado quando quiser modelos remotos.
OPENROUTER_API_KEY=

# O Ollama é usado como reserva/local quando configurado em vault/INSTRUCOES.md.
# Instale o modelo manualmente, por exemplo:
# ollama pull qwen2.5:7b-instruct-q4_K_M

# Usado pela API gratuita do Unpaywall para localizar PDFs open access por DOI.
UNPAYWALL_EMAIL=

# Opcional: chave do Semantic Scholar. O agente respeita 1 requisição/segundo.
SEMANTIC_SCHOLAR_API_KEY=

# Opcional: chave gratuita do CORE para buscar full text em repositórios open access.
CORE_API_KEY=
